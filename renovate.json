{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "platform": "github",
  "baseBranchPatterns": [
    "main"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "^mayangindex/gitlab-token-exporter$"
      ],
      "includePaths": [
        "^charts/.+"
      ],
      "enabled": true,
      "schedule": ["on monday"]
    }
  ]
}
